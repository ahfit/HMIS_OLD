      <Textbox Name="Textbox3">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>I testify that I am donating blood by my own will and I am ready to give relevant information, required for the safety of the donor and the patient. I am aware of the fact that my blood will tested for hepatitis B, hepatitis C and HIV/AIDS, and I also know about any side effects of blood donation. The information provided by me is correct to the best of my knowledge and I am willing to come again for any further test if required by the Kulsum International Hospital I(KIH) Blood Bank.I allow KIH blood bank to use my blood for the welfare of patients and I will never ask if my blood is transfused to any patient.</Value>
                <Style />
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>General</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Textbox3</rd:DefaultName>
        <Top>4.81472in</Top>
        <Left>1.39152in</Left>
        <Height>1.25in</Height>
        <Width>6.32813in</Width>
        <ZIndex>22</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <PaddingLeft>2pt</PaddingLeft>
          <PaddingRight>2pt</PaddingRight>
          <PaddingTop>2pt</PaddingTop>
          <PaddingBottom>2pt</PaddingBottom>
        </Style>
      </Textbox>
      <Textbox Name="Textbox4">
        <CanGrow>true</CanGrow>
