      <Textbox Name="Textbox12">
        <CanGrow>true</CanGrow>
        <CanShrink>true</CanShrink>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="We are enclosed a cheque No. " + First(Fields!Check_No.Value, "DataSet1")+" Dated. " + CDate(First(Fields!Approved_Date.Value, "DataSet1")).ToString("MMMM dd yyyy") + " for Rs. " + Sum(Fields!Salary_Amount.Value, "DataSet1").ToString() + "/- on account of staff salary for the month of " + Parameters!AmountInEng.Value + " drawn on your branch.  Kindly transfer the same to the following account."</Value>
                <Style>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>Textbox12</rd:DefaultName>
