        <CanShrink>true</CanShrink>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Enclosed Letter contain salary transfer to employee in cash of total amount of Rs. </Value>
                <Style>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Sum(Fields!Salary_Amount.Value)</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>0.00;(0.00)</Format>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>approved by </Value>
                <Style>
                  <FontWeight>Normal</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Fields!Approve_by.Value</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>on  </Value>
                <Style>
                  <FontWeight>Normal</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Fields!Approved_Date.Value</Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
                <Value>. </Value>
                <Style>
                  <FontWeight>Bold</FontWeight>
                  <Format>d</Format>
                  <TextDecoration>None</TextDecoration>
                </Style>
              </TextRun>
              <TextRun>
