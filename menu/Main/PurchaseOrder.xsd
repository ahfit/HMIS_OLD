                    <CommandText>SELECT     ISNULL(Medicine.MGName, '') + ' ' + ISNULL(Medicine.Potency, '') + ' ' + ISNULL(Medicine.Unit, '') AS [Item Name], Purchase_Order_Sub.Rate, 
