    <script type="text/javascript" language="javascript">
        $(document).ready(function() {
		 
            function getTemplateForm(elem) {
                var templateId = $(elem).parent().find("input[id$='hdnTemplateId']").val();
                window.location = "../Pt_EMR/Pt_Presenting_Complaint.aspx?TemplateId=" + templateId + "";
                return false;
            }

            $(document).on("click", ".toggle_open", function(e) {

                e.preventDefault();
                $("#patient_info_small").hide();
                $(".patient_info").show();

                //$("#patient_info_small").fadeOut(0);
                //$(".patient_info").slideDown(300);


            });

            $(document).on("click", ".toggle_close", function(e) {

                e.preventDefault();

                $("#patient_info_small").show();
                $(".patient_info").hide();
                // $("#patient_info_small").slideDown(200);
                // $("#patient_info").fadeOut(0);



            });

            ////////////////////

            //$(document).on("click",".mainpage_tabs li a",function(e){
            //		  
            //		  	e.preventDefault();
            //			$('.mainpage_tabs li a').removeClass('active');
            //			$(this).addClass('active');
            //			var thistxt = $(this).text();
            //			$('.hideall').hide();
            //			$('.'+thistxt+'_content').show();
            //			 
            //		 
            //		     });





            function toggle_visibility(id) {
                var e = document.getElementById(id);
                if (e.style.display == 'block' || e.style.display == '') {
                    e.style.display = 'none';
                } else {
                    e.style.display = 'block';
                }
            }


            $('.Grid_1 tr').click(function() {
                $('.Grid_1 tr').removeClass('gridedit');
                $(this).addClass('gridedit');
            });
        });
    </script>


