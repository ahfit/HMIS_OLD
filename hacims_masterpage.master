    <script type="text/javascript" src="<%=Page.ResolveUrl("~/Scripts/jquery.maskedinput.js")%>"></script>

    <script type="text/javascript">
        <!-- 
        //-->
        $(function() {
            //Define your mask (using 9 to denote any digit)
            $('#ctl00_ContentPlaceHolder1_txtRegNo').mask('99-99-99');
        });
        $(function() {
            $('#ctl00_ContentPlaceHolder1_txtRegistrationNo').mask('99-99-99');
        });
        $(function() {
            $('#ctl00_ContentPlaceHolder1_TextBoxRegNo').mask('99-99-99');
        });
        $(function() {
            $('#ctl00_ContentPlaceHolder1_TextBox_CNIC_No').mask('99999-9999999-9');
        });
        $(function() {
            $('#ctl00_ContentPlaceHolder1_txtCNIC').mask('99999-9999999-9');

            $('#ctl00_ContentPlaceHolder1_TextBoxCNIC').mask('99999-9999999-9');
        });
        $(function() {
            $('#ctl00_ContentPlaceHolder1_txtMobileNo').mask('9999-9999999');
        });

        $(function() {
            $('#ctl00_ContentPlaceHolder1_txtKinContact').mask('9999-9999999');
        });

        function txtChangeMR() {

            //var txt = document.getElementById("ctl00_ContentPlaceHolder1_txtRegNo");

            //if (txt.value.length == 2 || txt.value.length == 5) {
            //    txt.value = txt.value + "-";
            //}


        }
        $(function() {
            $('#ctl00_ContentPlaceHolder1_txtRegNo').keydown(function(e) {
                if (e.shiftKey || e.ctrlKey || e.altKey) {
                    e.preventDefault();
                } else {
                    var key = e.keyCode;
                    if (!((key == 8) || (key == 9) || (key == 46) || (key >= 35 && key <= 40) || (key >= 48 && key <= 57) || (key >= 96 && key <= 105))) {
                        e.preventDefault();
                    }
                }
            });
        });


        $(document).ready(function() {
            $("#ctl00_ContentPlaceHolder1_txtOPDNo").attr('maxlength', '6');

        });
        $(function() {
            $('#ctl00_ContentPlaceHolder1_txtOPDNo').keydown(function(e) {
                if (e.shiftKey || e.ctrlKey || e.altKey) {
                    e.preventDefault();
                } else {
                    var key = e.keyCode;
                    if (!((key == 8) || (key == 9) || (key == 46) || (key >= 35 && key <= 40) || (key >= 48 && key <= 57) || (key >= 96 && key <= 105))) {
                        e.preventDefault();
                    }
                }
            });
        });
    </script>
