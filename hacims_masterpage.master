    <style>
        body {
            background: #f4f4f4;
        }

        .header_right li a.hs_logoutt {
            color: #b40b25;
            border-right: #ccc solid 0px;
            padding-left: 10px;
            background: url(../resources/images/img_bullet_1.png) left 8px no-repeat;
            background-size: 4px;
        }

        .main_bx {
            margin-top: 35px;
        }

        .footer_txt {
            position: relative;
            height: 30px;
            text-align: centr;
            width: 100%;
            line-height: 30px;
            box-sizing: border-box;
            font-size: 13px;
            float: left1;
            display: inline-block;
        }

        .footer_txt a {
            color: #000c7b;
            text-decoration: none;
            text-align: center;
            margin: 0 auto;
        }

        .footer_txt a:hover {
            text-decoration: underline;
        }

        .content_main {
            margin-top: 40px;
        }
    </style>

