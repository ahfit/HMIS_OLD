    <script type="text/javascript" language="javascript">
        $(document).ready(function() {
            $('.captxt').bind('keyup', function() {
                var val = $(this).val().toUpperCase()
                $(this).val(val);
            });

            $("#basic_mrNumber").html($("#ctl00_FormView2_RegistrationNo").html());
            $("#basic_pInfo").html($("#ctl00_FormView2_PatientNameLabel").html() + ' ' + '<span style="color:#0091c6;">' + $("#ctl00_FormView2_RelationLabel").html() + '</span>' + ' ' + $("#ctl00_FormView2_RelationNameLabel").html());
            $("#basic_age").html('Age : ' + $("#ctl00_FormView2_AgeLabel").html() + ' Year(s)');
            $("#basic_yearlyNo").html('100218');
            $("#basic_address").html($("#ctl00_FormView2_Label_Address").html());




        });
    </script>
    <script type="text/javascript">
        $(document).ready(function() {

            var cdate = new Date();
            var cyear = cdate.getFullYear();
            $("#cyear").html(cyear);


            $(".intdata").keydown(function(event) {



                if (!(event.keyCode == 8 ||
                        event.keyCode == 46 ||
                        event.keyCode == 9 ||
                        event.keyCode == 190 ||
                        (event.keyCode >= 35 && event.keyCode <= 40) ||
                        (event.keyCode >= 48 && event.keyCode <= 57)

                        ||
                        (event.keyCode >= 96 && event.keyCode <= 105))) {
                    event.preventDefault();
                }
 
            });
			
			/////////////////
			
			$(document).on("click",".right_usermenu1",function(e){
		  
		  	e.preventDefault();
		  
		 
					$(".right_usermenu_cnt").fadeToggle(); 

		             var pos_menu = $(this).position();
					 console.log(pos_menu);
		 $(".right_usermenu_cnt").css( "left", pos_menu.left - 148);   
		 $(".right_usermenu_cnt").css( "top", pos_menu.top + 80);
		 
			
	    });
	  
			
			/////////////////
        });
    </script>
    <script>
        $(document).ready(function() {
