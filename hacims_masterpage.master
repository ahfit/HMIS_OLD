    </script>
    <script>
        $(document).ready(function() {
            $("#button2").click(function() {
                $("#hide2").toggle();
            });
			
				/////////LeftSideMenu
				
				  var tabhtml=""; var contentHtml ="";
	   $('.CollapsiblePanelTab').each(function(index, element) {
		  
        
				    tabhtml += "<li><div>"+$(this).html()+"</div>";
				    tabhtml +="<ul>"; 
				   
				   $(this).parent().find('a').each(function(index, element) {  
				   						
				   				   var href =  $(this).attr('href');
								   var thisClass =  $(this).html().replace(' ','').replace(' ','').replace(' ','');
				   				   tabhtml += '<li><a href="'+href+'" class="'+thisClass+'">'+$(this).html()+'</a></li>';
				   });
		 		  tabhtml +="</ul>"; 
				  tabhtml +="</li>"; 	
      });
		
		$("#menuScroll").html("");
		$("#menuScroll,.leftMenu_divcnt").append("<ul class='tabs_left'>"+tabhtml+"</ul>");	
		
			 $(document).on("click",".tabs_left li a",function(e){
		  
		    // e.preventDefault();
			 $('.tabs_left a,.tabs_left div').removeClass('active');
			 
			 var thisClass = $(this).attr('class');			  		
			 Cookies.set('activeLink', thisClass); 	
			 
			 $(this).addClass('active');
			 $(this).parent().parent().prev('div').addClass('active');
		 	
            
		      });   
	
			  var activeLink = Cookies.get('activeLink');			  
			  $('.'+activeLink).addClass('active');
			  $('.'+activeLink).parent().parent().prev('div').addClass('active');
                  
             
			  $('.pageTitle').html("<span>"+$('.'+activeLink).parent().parent().prev('div').html()+'</span> &rsaquo; '+$('.'+activeLink).html()); 
	  
			
				///////////
				
				 
			
	  
			//	$(".leftMenu_Divcnt").mCustomScrollbar({ axis:"y",theme:"minimal-dark" });
       	 
				 //////
			
				var desk = true;
		 	if( /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ) {
  				
							 desk = false;  $('.leftMenu_div').hide();
						$(".pageContent").css("padding-left","15px");
						$(".mainpage_tabs").css("padding-left","0px"); }else {  desk = true;  } 	
		 	
				$(document).on("click",".left_usermenu,#lightbox_bgm",function(e){
		  
		  	e.preventDefault();
			    
					   if(desk){
						   
						 var mld = $('.leftMenu_div').css('display');   
						
						if(mld=="none"){  
						
						$('.leftMenu_div').show();
						$(".pageContent").css("padding-left","230px");
						$(".mainpage_tabs").css("padding-left","218px");
						
						 	 
						}else { 
						
						$('.leftMenu_div').hide();
						$(".pageContent").css("padding-left","15px");
						$(".mainpage_tabs").css("padding-left","0px");
						 
					  
					    }	  
				 		
					   }else {
						   
						   
						 
					   $('.slideLeftMenu').animate({width: 'toggle'},300);
					  
					    var ml = $('#lightbox_bgm').css('display');
						  
						if(ml=="none"){  $('#lightbox_bgm').fadeIn(300,function(){  });
						 	 
						}else {  $('#lightbox_bgm').fadeOut(300,function(){ }); 
					  
					    }	  
						   
						     }
						
						
										 
		    });
		  
		  
				var pHeight = $('.pageContent').outerHeight()+25;
	  			 console.log(pHeight);
				 if(pHeight>300){
	  			 $(".leftMenu_Div").height(pHeight+"px");
				 }else {  $(".leftMenu_Div").height("520px"); }	
							
        });
    </script>




