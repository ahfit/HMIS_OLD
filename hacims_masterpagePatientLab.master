<ItemTemplate>

<div id="p_info" class="patient-info">

 <table width="100%" border="0" cellspacing="0" cellpadding="0">
  <tr>
    <%--<td valign="top"><img name="" visible="false" src="Employee_pic.aspx"  style="width:50px;" alt="" onclick="MM_openBrWindow('Employee_pic.aspx','','width=300,height=350')"  /></td>--%>
    <td  valign="top" style="padding-left:10px; width:50%">
    
<ul>
<li>
<span class="name-p"> <asp:Label id="PatientNameLabel" runat="server"  Text='<%# Eval("prefix", "{0}") %>'></asp:Label></span>
<span class="relation">&nbsp;<asp:Label id="RelationLabel" runat="server" Text='<%# Bind("Relation", "{0}") %>'></asp:Label>&nbsp;</span>
<strong><asp:Label id="RelationNameLabel" runat="server"  Text='<%# Eval("RELATIONNAME", "{0}") %>'></asp:Label></strong>
<span class="age"><asp:Label id="AgeLabel" runat="server"  Text='<%# Bind("Age") %>' ></asp:Label>  Year(s)<span class="splt">|</span><asp:Label id="LabelDateofBirth" runat="server"  Text='<%# Eval("DateOfBirth") %>' ></asp:Label><span class="splt">|</span><asp:Label id="LabelGender" runat="server" Text='<%# Eval("Gender", "{0}") %>'></asp:Label></span>
<span class="add"> <asp:Label ID="Label_Address" runat="server" Text='<%# Bind("Address", "{0}") %>' ></asp:Label></span>
<span class="age">MR # &nbsp;<span class="reg"><asp:Label id="RegistrationNo" runat="server" Text='<%# Eval("RegNo") %>'></asp:Label></span><span class="splt">|</span>&nbsp;<span class="visit"><div style ="display :none"><asp:Label ID="Label_PayID" runat="server" Text='<%# Eval("PayID") %>'></asp:Label></div>
    <span class="docname" title="Doctor Name">
    <asp:Label ID="Label_DoctorName" runat="server" 
        Text='<%# Bind("DoctorName", "{0}") %>'></asp:Label>
    <span title="Department">&nbsp;<asp:Label ID="Label_Department" runat="server" 
        Text='<%# Eval("Dept_Name") %>'></asp:Label>
    <span class="splt">/<strong><asp:Label ID="Label1" runat="server" 
        Text='<%# Bind("BedNo", "{0}") %>'></asp:Label>
    </strong><asp:Label ID="Label_SubDept" runat="server" 
        Text='<%# Eval("SubDept_Name") %>'></asp:Label><span class="splt">|</span>
    <span class="age red" title="Diagnosis"><asp:Label ID="Label_Diagnosis" 
        runat="server" Text='<%# Bind("Diagonosis", "{0}") %>' Visible="false"></asp:Label>
    </span>
    </span></span></span></span></span>
</li>
</ul> 
    
</td>

