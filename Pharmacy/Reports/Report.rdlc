                    <Textbox Name="Textbox64">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Round(Fields!Total.Value - ((Fields!Unit_Rate.Value*Fields!Discount.Value)/100)*Fields!Consumed_QTY.Value,0)</Value>
