                <Style>
                  <FontSize>7.5pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=Sum(Fields!Total.Value - (Fields!Discount.Value * Fields!Total.Value / 100))</Value>
