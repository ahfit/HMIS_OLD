      <button type="button" class="navbar-toggle hidden-sm hidden-xs" style="background-color:white;  padding: 1em 1.6em 1em 1.6em;border-radius: 11px; margin-top: -4em;" data-toggle="collapse" data-target="#navMain">
  <span class="glyphicon glyphicon-list" style="    font-size: 1.7em; color: #425ead; "></span>
      
  </button>
