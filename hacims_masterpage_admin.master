    <script type="text/javascript" language="javascript">
        $(document).ready(function () {
            $('.Grid_1 tr').click(function () {
                $('.Grid_1 tr').removeClass('gridedit');
                $(this).addClass('gridedit');
            });
        });
    </script>


   


    <script type="text/javascript" language="javascript">
        $(function () {
            $(".box").dialog({
                autoOpen: false,
                modal: true
            });

            $(".openbox").click(function () {
                $(".box").dialog("open");

                return false;
            });
        });

    </script>

    <script type="text/javascript" language="javascript">

        $(document).ready(function () {
            $('.captxt').bind('keyup', function () {
                var val = $(this).val().toUpperCase()
                $(this).val(val);
            });
        });

    </script>
    <script type="text/javascript">


        $(document).ready(function () {
            $(".intdata").keydown(function (event) {



                if (!(event.keyCode == 8
            || event.keyCode == 46
            || event.keyCode == 9
             || event.keyCode == 190
            || (event.keyCode >= 35 && event.keyCode <= 40)
            || (event.keyCode >= 48 && event.keyCode <= 57)

            || (event.keyCode >= 96 && event.keyCode <= 105))
            ) {
                    event.preventDefault();
                }



            });
        });

    </script>
    <script type="text/javascript">

        $(function () {
            $(".datepicker").datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: 'dd/mm/yy',
                currentText: 'Now'

            });

            $(".datepicker").datepicker('setDate', new Date());
        });


        $(window).scroll(function () {
            if ($(this).scrollTop() > 50)  /*height in pixels when the navbar becomes non opaque*/ {
                $('.opaque-navbar').addClass('opaque');
            } else {
                $('.opaque-navbar').removeClass('opaque');
            }
        });


    </script>

   

    <style type="text/css">
        #cfg {
                   top: 3px;
    background-color: #7471c8;
    color: #fff;
    float: right;
    box-shadow: 0 0px 2px #999;
    position: absolute;
    border-radius: 4px;
    padding: 0.5em 1em;
    right: 0.1em;
        }

        .StaticMenuItemStyle {
         background: url(../images_hacims/img_spltb.jpg)right 6px no-repeat;
        
            color: #0048a0;
            padding: 10px;
        }

            .StaticMenuItemStyle img {
                display: none;
            }


        .StaticMenuItemStyle2 {
            color: white;
                  border-right: 1px solid white;
                 padding: 0em 0.5em;
        }

        .StaticMenuItemStyle3 {
              
    background-color: white;
    color: rgb(37, 52, 92);
    border-top: 2px solid white;
    padding-left: 10px;
    border-radius: 10px;
    border-bottom: 1px solid rgb(37, 52, 92);
        }

            .StaticMenuItemStyle3 td {
                text-align: left;
            }


        .StaticMenuItemStyle4 {
            color: #0048a0;
            background-color:  #7471c8;
            border-radius: 5px;
        }

        .StaticMenuItemStyle2 img {
            display: none;
        }

        .StaticHoverStyle {
            font-weight:700;
           border-radius: 6px;
            color: #87ceeb;
        }
    

        .nav > li > a {
            display: unset;
        }
            #header {
            height: 86px;
            display: block;
            float: left;
            clear: right;
            width: 100%;
            background: url(../images_hacims/img_logo333.jpg) 40px 6px no-repeat;
            font-family: Calibri;
        }
            section
{
  background:yellow;
}
.banner
{
  background:red;
  min-height:200px;
}
.banner .row
{
  text-align:center;
  margin-top:50px;
}
.banner h1
{
  color:white;
}

.menuXs
{
    color: white;
    border-bottom: 2px solid #4360b3;
    padding: 0px 1.5em;
    text-align: left;
    margin-top: 0.7em;
  
}
  .menuXs img {
                display: none;
            }

  .menuXsHover
  {
      background-color:#4360b3;
      color:white;
  }

  .menuXsHover a:focus, a:hover {
    color: #ffffff;
    text-decoration: underline;
}

   .menuXsHoverDynamic
  {
      background-color:white;
      color:#4360b3;
      border-bottom: 2px solid #4360b3;
       padding: 0px 1.5em;
       text-align: left;
  }
    .menuXsHoverDynamic2
  {
      background-color: rgba(40,57,101,.9);
      color:white;
  }

   .menuXsHoverDynamic2 a:focus, a:hover {
    color: #ffffff;
    text-decoration: underline;
}




/***********************************************************************
*  OPAQUE NAVBAR SECTION
***********************************************************************/
.opaque-navbar {
    background-color: rgba(0,0,0,0.5);
  /* Transparent = rgba(0,0,0,0) / Translucent = (0,0,0,0.5)  */
    height: 60px;
    border-bottom: 0px;
    transition: background-color .5s ease 0s;
}

.opaque-navbar.opaque {
    background-color: #87ceeb;
    height: 60px;
    transition: background-color .5s ease 0s;
}

ul.dropdown-menu {
    background-color: black;
}



  .opaque-navbar {
    background-color: #87ceeb;
    height: 60px;
    transition: background-color .5s ease 0s;
}







    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>
<body>
