  </button>
        <button id="button2" type="button" class="btn hidden-md hidden-sm visible-xs" style="background-color: #38383800; float: right; margin-top: -6.6em;" data-toggle="collapse" data-target="#collapse3">
            <span class="glyphicon glyphicon-list" style=" font-size: 2.3em; color: #ffffff; "></span>
