      <Textbox Name="Textbox3">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>میں ـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ  ولدیت/زوجہ  ـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ اپنے مریض ـــــــــــــــــــــــــــــــــــــــــــــــــــــــــ کی ہر قسم کی بے ہوشی میں آپریشن کی مکمل اجازت دیتا ہوں۔ مجھے آپریشن کی پیچدگی، دوران آپریشن اور آپریشن کے بعد آنے والے تمام مسائل سے اچھی طرح آگاہ کردیا گیا ہے۔ اگر مریض یا بچے کے ساتھ کوئی ایمرجنسی ہوئی تو ہسپتال کے عملے کو اجازت ہو گی کے مریض کی بہتری کے لیے دوسرے ہسپتال منتقل کر دیں اور میں ان مسائل اور مریض کی منتقلی کے لیے تیار ہونگا اور ڈاکٹر، ہسپتال یا عملے کو زمہ دار نہیں ٹھراوَں گا۔ مجھے آپریشن کے بعد ہونے والی پیچیدگی اور تمام نتائج بھی قبول ہونگےــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ

</Value>
