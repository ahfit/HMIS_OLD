          <Textbox Name="Textbox7">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>         میں اپنی مرضی سے الخدمت رازی ہسپتال اسلام آباد میں اپنی / اپنے مریض کے داخلے کیلئے درخواست کرتا /کرتی ہوں اود اس امر کی اجازت دیتا /دیتی ہوں کہ مرض کی تشحیص اود علاج  کیلئے بشمول انجکشن ، خون ، لیبارٹری ٹسٹ ، ایکسرے ، اور بےحس کرنے کیلئے طریقہ کاد وغیرہ جو بہی مناسب ہوگا اس عمل میں لایا جاسکتا ہے۔ مزید براں میں یہ سمجھتے ہوئے کہ کوئی بھی عمل خطرے سے خالی نہیں، ہسپتال کی انتظامیہ یا  ہسپتال کے کسی ملازم کو ہرجانہ دینے سے بری الزمہ سمجھتا / سمجھتی ہوں۔</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Right</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox7</rd:DefaultName>
