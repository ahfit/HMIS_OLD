<%@ master language="VB" inherits="hacims_masterpage_PatientVisit, App_Web_uj03ztnp" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc1" %>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="head1" runat="server">

<title>HACIMS</title>
      <!--Styles -->
    <link href="~/css_hacims/class_reset.css" rel="stylesheet" type="text/css" media="screen, projection" />
    <link href="~/css_hacims/class_content.css" rel="stylesheet" type="text/css" media="screen, projection" />
    <link href="~/css_hacims/bootstrap.min.css" rel="stylesheet" type="text/css" media="screen, projection" />
    <link href="~/css_hacims/colorbox.css" rel="stylesheet" type="text/css" media="screen, projection" />
    <link href="~/css_hacims/jquery_ui/themes/base/jquery.ui.all.css" rel="stylesheet" type="text/css" media="screen, projection" />


    <link rel="shortcut icon" href="images_hacims/favicon.ico" />
    <!--Scripts-->
   
     <script src="<%# Page.ResolveClientUrl("~/Scripts/jquery.min.js") %>" type="text/javascript" language="javascript"></script>
    <script src="<%# Page.ResolveClientUrl("~/Scripts/bootstrap.min.js") %>" type="text/javascript" language="javascript"></script>
<%--    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery.cookie.js")%>"></script>    --%>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/Scripts/jquery.colorbox-min.js")%>"></script>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery.floatobject-1.0.js") %>"></script>

    
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.core.js") %>"></script>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.widget.js") %>"></script>
    <%--<script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.mouse.js") %>"></script>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.draggable.js") %>"></script>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.position.js") %>"></script>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.resizable.js") %>"></script>--%>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.dialog.js") %>"></script>
    <script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/jquery_ui/ui/jquery.ui.datepicker.js")%>"></script>
    <%--<script type="text/javascript" src="<%# Page.ResolveClientUrl("~/css_hacims/validate.js")%>"></script>--%>

<script type="text/javascript">
		$(document).ready(main);
		function main()
		{
			$("#feedb").makeFloat({x:"current",y:"current"});
		}		
	</script>
    
	<script type="text/javascript">
		$(document).ready(function(){
			
		//	$(".feed").colorbox({width:"800px", height:"430px", iframe:true});
			$(".rpt_link").colorbox({width:"920px", height:"90%", iframe:true});
		
		});
	</script>  
    
    
<script type="application/javascript">
  
   $(document).ready(function () { 
   
    
	var hs = $("#ctl00_hospital:input").val();
	 
		if (hs == 10  ) { $('#header').css("background-image", "url(~/images_hacims/img_logo.png)"); }  
		else if  (hs == 11  ) { $('#header').css("background-image", "url(~/images_hacims/img_logo2.png)");} 
	    else  { $('#header').css("background-image", "url(~/images_hacims/img_logo3.png)"); } 
	    // alert(hs);
    
});

 

</script> 

<asp:ContentPlaceHolder id="head" runat="server"> </asp:ContentPlaceHolder>
   
</head>
<body>
 <form id="form1" runat="server" autocomplete="off">
 
<asp:TextBox ID="hospital" runat="server" CssClass="input_txt" Style="display:none;"     ></asp:TextBox>
 <div id="container">
 <div id="feedb" style ="display :none;"><a href="~/administrator/feedback.aspx" runat="server" class="feed"></a></div>
  <div id="header">
    <div id="logininfo">
      <ul>
        <li class="welcome">Welcome!<span class="dname"><asp:Label ID="LabelDoctorName" runat="server" ToolTip="User Name" ></asp:Label></span><span class="spltr">|<asp:Label
            ID="Label_Designation" runat="server" ToolTip="User Designation" ForeColor="DarkGray"></asp:Label></span><span class="designation"></span><span class="spltr">|</span><span class="dept"><asp:Label ID="Label_SubDepartment" runat="server" ToolTip="User Deprartment" style="color:#97ba3a;" Text="Label_SubDepartment"></asp:Label></span><span class="spltr">|&nbsp;</span><a id="AB" href="~/change_password.aspx" class="cpass" runat="server" >Change Password</a>
            <asp:Literal ID="ltrDemo" runat="server" Text=""></asp:Literal>
            <span class="spltr">|&nbsp;</span><a href="~/login.aspx" title="Logout" runat="server" >Logout</a></li>
        
        <li class="datet"><asp:Label ID="LabelDate" runat="server" ToolTip="Current Date"  style="color:#0155a6;"></asp:Label></li>
        
      </ul>
    </div>
    <div id="navigation"   style="margin-right:12px; " >
             
     <asp:Panel ID="Panel1"   CssClass="posmenu" runat="server"></asp:Panel> 
   
      
    </div> <!--navigation END-->
  </div>
  <!--header END-->
  
<div id="content" > 
  
<div id="inner-content">
<h1 class="mh1"><span><asp:SiteMapPath ID="SiteMapPath1" runat="server"   CurrentNodeStyle-ForeColor="#000"  RenderCurrentNodeAsLink="true" PathSeparator="&nbsp;&nbsp;&raquo;&nbsp;&nbsp;" RootNodeStyle-ForeColor="#999999" PathDirection="RootToCurrent"></asp:SiteMapPath></span> 
   </h1>
  <asp:HyperLink ID="HyperLink1" runat="server" 
    NavigateUrl="~/PatientFaceSheet.aspx"  
    CssClass="rpt_link"></asp:HyperLink>
  



<div id="patient_info" runat="server" style="margin-top:5px; margin-bottom:5px;" >













  <asp:SqlDataSource ID="patient_detail" runat="server" ConnectionString="<%$ ConnectionStrings:Reg_ConnectionString %>"
            SelectCommand="pt_basic_info" SelectCommandType="StoredProcedure" ProviderName="<%$ ConnectionStrings:Reg_ConnectionString.ProviderName %>">
            <SelectParameters>
                <asp:ControlParameter ControlID="HiddenField_regNo" Name="regno" PropertyName="Value"
                    Type="String" />
                <asp:ControlParameter ControlID="HiddenField_Payis" Name="payid" PropertyName="Value"
                    Type="Int32" />
            </SelectParameters>
        </asp:SqlDataSource>
        <asp:HiddenField ID="HiddenField_regNo" runat="server" />
        <asp:HiddenField ID="HiddenField_Payis" runat="server" />
  
                 <asp:ObjectDataSource ID="ObjectDataSource1" runat="server">
                 </asp:ObjectDataSource>
  
  
  
  
  
  </div></div>
<div id="forms_items" style="min-height:400px;" >
<asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
 
 </div>
<asp:Label ID="label_i_f" runat ="server" Visible="false" ></asp:Label>
<br />
<br />

 <asp:HiddenField ID="HiddenFieldPage_Name" runat="server" /><asp:HiddenField ID="HiddenFieldPage" runat="server" /> 
  
  
 </div> <!--inner-content END-->
 </div>
  <!--content END-->
  <div id="footer"><span><a href="#" title="HACIMS - Design &amp; Developed by MegaPlus Technologies" target="_blank">&copy; 2012  -  All rights reserved - MegaPlus Technologies</a></span></div>

<!--container END-->
 
 
 
        
      
    
 </form>
</body>
</html>
